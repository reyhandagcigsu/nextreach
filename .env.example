# NextReach — environment variables
# Copy this file to .env.local and fill in the values.
# .env.local is gitignored; .env.example is committed as documentation.

# Supabase project (Project Settings -> API)
VITE_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Simple gate for the /admin view (auth is out of scope).
# NOTE: Vite inlines this into the client bundle — it is a deterrent, not real
# security. Real protection requires Supabase Auth + RLS (out of scope).
VITE_ADMIN_PASSWORD=change-me
